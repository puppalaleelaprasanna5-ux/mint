# Copy to .env and fill in what you have. Everything here is SERVER-SIDE ONLY:
# never prefix these with NEXT_PUBLIC_, never commit .env.

# Local SQLite database (path is relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# ── Upstox (India: NSE/BSE daily history) ──────────────────────────────
# Recommended: the free, read-only "Analytics Token" (valid 1 year).
# Upstox Developer Apps → Analytics tab → Generate Token.
# A daily OAuth access token also works but expires every day.
UPSTOX_ACCESS_TOKEN=""

# ── Alpaca (US stocks daily history) ───────────────────────────────────
# Alpaca dashboard → API Keys. Market data only is used; no trading calls are made.
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
# "iex" (default; documented as usable without a subscription, volume = IEX trades only)
# or "sip" (full-market volume; only if your Alpaca plan permits SIP historical data).
ALPACA_DATA_FEED="iex"

# ── AI explanations (Phase 4) ──────────────────────────────────────────
# Off unless set. "mock" = deterministic development provider (no network, no key).
# Real providers (e.g. Groq) are not implemented yet; their keys will also live here, server-side only.
AI_PROVIDER=""
